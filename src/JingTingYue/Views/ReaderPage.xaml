<Page
    x:Class="JingTingYue.Views.ReaderPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Background="{StaticResource MainBgBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="76" />
            <RowDefinition Height="*" />
            <RowDefinition Height="64" />
        </Grid.RowDefinitions>

        <!-- ===== 顶栏 ===== -->
        <Grid Grid.Row="0" Padding="24,0,24,0" Background="{StaticResource ChromeBgBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Click="BackShelf_Click" Background="Transparent" BorderThickness="0"
                    Height="42" VerticalAlignment="Center" Padding="8,0">
                <StackPanel Orientation="Horizontal" Spacing="9">
                    <FontIcon Glyph="&#xE76B;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{StaticResource BookInkBrush}"/>
                    <TextBlock Text="书架" FontSize="14" Foreground="{StaticResource BookInkBrush}"/>
                </StackPanel>
            </Button>

            <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="620">
                <TextBlock x:Name="BookTitleText" Text="" FontFamily="Microsoft YaHei UI" FontSize="17"
                           FontWeight="SemiBold" Foreground="{StaticResource BookInkBrush}" TextTrimming="CharacterEllipsis" TextAlignment="Center"/>
                <TextBlock x:Name="BookAuthorText" Text="" FontFamily="Microsoft YaHei UI" FontSize="12"
                           Foreground="{StaticResource MutedInkBrush}" TextAlignment="Center" HorizontalAlignment="Center"/>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Click="TocToggle_Click" Background="{StaticResource SidebarBgBrush}" BorderThickness="0" Padding="15,10" CornerRadius="13" ToolTipService.ToolTip="目录">
                    <TextBlock Text="目录" FontFamily="Microsoft YaHei UI" FontSize="13" Foreground="{StaticResource BookInkBrush}" />
                </Button>
                <Button Click="Note_Click" Background="{StaticResource SidebarBgBrush}" BorderThickness="0" Padding="15,10" CornerRadius="13" ToolTipService.ToolTip="记笔记">
                    <TextBlock Text="笔记" FontFamily="Microsoft YaHei UI" FontSize="13" Foreground="{StaticResource BookInkBrush}" />
                </Button>
                <Button Click="NotesList_Click" Background="{StaticResource SidebarBgBrush}" BorderThickness="0" Padding="15,10" CornerRadius="13" ToolTipService.ToolTip="阅读手记">
                    <TextBlock Text="手记" FontFamily="Microsoft YaHei UI" FontSize="13" Foreground="{StaticResource BookInkBrush}" />
                </Button>
                <Button Click="OpenTtsPanel_Click" Background="{StaticResource ForestGreenBrush}" BorderThickness="0" Padding="17,10" CornerRadius="16" ToolTipService.ToolTip="朗读">
                    <Button.Resources>
                        <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="ForestGreenBrush"/>
                        <StaticResource x:Key="ButtonForegroundPointerOver" ResourceKey="OnAccentBrush"/>
                        <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="ForestGreenDeepBrush"/>
                        <StaticResource x:Key="ButtonForegroundPressed" ResourceKey="OnAccentBrush"/>
                    </Button.Resources>
                    <TextBlock Text="朗读" FontFamily="Microsoft YaHei UI" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource OnAccentBrush}" />
                </Button>
                <Button Click="OpenSettings_Click" Background="{StaticResource SidebarBgBrush}" BorderThickness="0" Padding="15,10" CornerRadius="13" ToolTipService.ToolTip="外观与设置">
                    <TextBlock Text="Aa" FontFamily="Microsoft YaHei UI" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource BookInkBrush}" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- ===== 正文区：目录侧栏 + WebView ===== -->
        <Grid Grid.Row="1" Background="{StaticResource MainBgBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="TocColumn" Width="0" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource SidebarBgBrush}">
                <StackPanel Padding="20,18,10,10">
                    <TextBlock Text="目录" FontFamily="Microsoft YaHei UI" FontSize="13" FontWeight="SemiBold"
                               Foreground="{StaticResource MutedInkBrush}" Margin="0,0,0,10"/>
                    <ScrollViewer>
                        <StackPanel x:Name="TocList" Spacing="2"/>
                    </ScrollViewer>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Margin="28,30,28,22" MaxWidth="1900" HorizontalAlignment="Stretch" Background="{StaticResource ChromeBgBrush}" CornerRadius="18">
                <Grid x:Name="ReaderHost" Background="{StaticResource ChromeBgBrush}"/>
            </Border>

            <!-- ===== 朗读大面板（Apple Books 风格） ===== -->
            <Border Grid.ColumnSpan="2" x:Name="TtsPanel" CornerRadius="22" Background="{StaticResource ChromeBgBrush}" Padding="26,24"
                    BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Width="440" Visibility="Collapsed">
                <StackPanel Spacing="18">
                    <Grid>
                        <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                            <Border Width="52" Height="52" CornerRadius="16" Background="{StaticResource SelectedSageBrush}">
                                <TextBlock Text="声" FontFamily="KaiTi" FontSize="24" Foreground="{StaticResource ForestGreenBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel>
                                <TextBlock Text="让故事读给你听" FontFamily="Microsoft YaHei UI" FontSize="17"
                                           FontWeight="SemiBold" Foreground="{StaticResource BookInkBrush}"/>
                                <TextBlock Text="从当前页开始朗读" FontFamily="Microsoft YaHei UI" FontSize="12"
                                           Foreground="{StaticResource MutedInkBrush}"/>
                            </StackPanel>
                        </StackPanel>
                        <Button Click="CloseTtsPanel_Click" Background="{StaticResource SidebarBgBrush}" BorderThickness="0"
                                HorizontalAlignment="Right" Width="36" Height="36" CornerRadius="18" Padding="0">
                            <TextBlock Text="×" FontFamily="Microsoft YaHei UI" FontSize="16" Foreground="{StaticResource BookInkBrush}"/>
                        </Button>
                    </Grid>

                    <StackPanel Spacing="6">
                        <TextBlock Text="选择声音" FontFamily="Microsoft YaHei UI" FontSize="12"
                                   Foreground="{StaticResource MutedInkBrush}"/>
                        <Grid x:Name="VoiceGrid">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                        </Grid>
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Text="播放速度" FontFamily="Microsoft YaHei UI" FontSize="12"
                                   Foreground="{StaticResource MutedInkBrush}"/>
                        <StackPanel x:Name="RateSeg" Orientation="Horizontal" Spacing="6"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <TextBlock Text="定时停止" FontFamily="Microsoft YaHei UI" FontSize="12"
                                   Foreground="{StaticResource MutedInkBrush}"/>
                        <ComboBox MinWidth="120">
                            <ComboBoxItem Content="不定时" IsSelected="True"/>
                            <ComboBoxItem Content="读完本章"/>
                            <ComboBoxItem Content="15 分钟后"/>
                            <ComboBoxItem Content="30 分钟后"/>
                            <ComboBoxItem Content="60 分钟后"/>
                        </ComboBox>
                    </StackPanel>

                    <Button x:Name="StartTtsButton" Click="StartTts_Click"
                            Background="{StaticResource ForestGreenBrush}" BorderThickness="0"
                            Height="48" CornerRadius="24">
                        <Button.Resources>
                            <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="ForestGreenBrush"/>
                            <StaticResource x:Key="ButtonForegroundPointerOver" ResourceKey="OnAccentBrush"/>
                            <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="ForestGreenDeepBrush"/>
                            <StaticResource x:Key="ButtonForegroundPressed" ResourceKey="OnAccentBrush"/>
                        </Button.Resources>
                        <TextBlock x:Name="StartTtsLabel" Text="开始朗读" FontFamily="Microsoft YaHei UI" FontSize="15"
                                   FontWeight="SemiBold" Foreground="{StaticResource OnAccentBrush}"/>
                    </Button>
                    <Button x:Name="StopTtsButton" Click="Stop_Click" Background="Transparent" BorderThickness="0" Content="停止朗读" IsEnabled="False"
                            Foreground="{StaticResource MutedInkBrush}" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="TtsStatus" Text="● 准备就绪" FontFamily="Microsoft YaHei UI" FontSize="11"
                               Foreground="{StaticResource MutedInkBrush}" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- ===== 阅读手记面板 ===== -->
            <Border Grid.ColumnSpan="2" x:Name="NotesPanel" CornerRadius="24" Background="{StaticResource ChromeBgBrush}" Padding="30,26"
                    HorizontalAlignment="Center" VerticalAlignment="Center" Width="560" Height="640"
                    Visibility="Collapsed">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <StackPanel>
                            <TextBlock x:Name="NotesCountLabel" Text="0" FontFamily="Microsoft YaHei UI"
                                       FontSize="12" Foreground="{StaticResource MutedInkBrush}"/>
                            <TextBlock Text="阅读手记" FontFamily="Microsoft YaHei UI" FontSize="32"
                                       FontWeight="Bold" Foreground="{StaticResource BookInkBrush}" Margin="0,4,0,4"/>
                            <TextBlock x:Name="NotesBookLabel" Text="" FontFamily="Microsoft YaHei UI" FontSize="13"
                                       Foreground="{StaticResource MutedInkBrush}" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <Button Click="CloseNotes_Click" Background="{StaticResource SidebarBgBrush}" BorderThickness="0"
                                HorizontalAlignment="Right" Width="40" Height="40" CornerRadius="20" Padding="0">
                            <TextBlock Text="×" FontFamily="Microsoft YaHei UI" FontSize="16" Foreground="{StaticResource BookInkBrush}"/>
                        </Button>
                    </Grid>
                    <TextBox x:Name="NotesSearch" Grid.Row="1" PlaceholderText="搜索摘录或想法" Height="44"
                             Margin="0,20,0,14" FontFamily="Microsoft YaHei UI" FontSize="14"
                             TextChanged="NotesSearch_TextChanged"/>
                    <ScrollViewer Grid.Row="2">
                        <StackPanel x:Name="NotesListPanel" Spacing="12"/>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- ===== 设置面板（居中弹窗） ===== -->
            <Border Grid.ColumnSpan="2" x:Name="SettingsPanel" CornerRadius="24" Background="{StaticResource ChromeBgBrush}" Padding="28,24"
                    HorizontalAlignment="Center" VerticalAlignment="Center" Width="380"
                    Visibility="Collapsed">
                <StackPanel Spacing="16">
                    <Grid>
                        <TextBlock Text="阅读设置" FontFamily="Microsoft YaHei UI" FontSize="20" FontWeight="Bold"
                                   Foreground="{StaticResource BookInkBrush}" VerticalAlignment="Center"/>
                        <Button Click="CloseSettings_Click" Background="{StaticResource SidebarBgBrush}" BorderThickness="0"
                                HorizontalAlignment="Right" Width="36" Height="36" CornerRadius="18" Padding="0">
                            <TextBlock Text="×" FontFamily="Microsoft YaHei UI" FontSize="16" Foreground="{StaticResource BookInkBrush}"/>
                        </Button>
                    </Grid>

                    <StackPanel Spacing="6">
                        <TextBlock Text="主题" FontFamily="Microsoft YaHei UI" FontSize="12"
                                   Foreground="{StaticResource MutedInkBrush}"/>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Click="Theme_Click" Tag="paper" Height="36" Width="90" CornerRadius="12"
                                    BorderThickness="1" BorderBrush="{StaticResource HairlineBrush}" Background="{StaticResource NoteCardBrush}" Foreground="{StaticResource BookInkBrush}" Content="纸白"/>
                            <Button Click="Theme_Click" Tag="sepia" Height="36" Width="90" CornerRadius="12"
                                    BorderThickness="1" BorderBrush="{StaticResource HairlineBrush}" Background="{StaticResource NoteCardBrush}" Foreground="{StaticResource BookInkBrush}" Content="羊皮纸"/>
                            <Button Click="Theme_Click" Tag="night" Height="36" Width="90" CornerRadius="12"
                                    BorderThickness="1" BorderBrush="{StaticResource HairlineBrush}" Background="{StaticResource NoteCardBrush}" Foreground="{StaticResource BookInkBrush}" Content="夜间"/>
                        </StackPanel>
                    </StackPanel>

                    <ComboBox x:Name="FontCombo" Header="字体" HorizontalAlignment="Stretch"
                              SelectionChanged="FontCombo_SelectionChanged">
                        <ComboBoxItem Content="楷体" Tag="KaiTi,STKaiti,serif" IsSelected="True"/>
                        <ComboBoxItem Content="宋体" Tag="SimSun,STSong,serif"/>
                        <ComboBoxItem Content="仿宋" Tag="FangSong,STFangsong,serif"/>
                        <ComboBoxItem Content="微软雅黑" Tag="Microsoft YaHei,PingFang SC,sans-serif"/>
                        <ComboBoxItem Content="黑体" Tag="SimHei,Heiti SC,sans-serif"/>
                        <ComboBoxItem Content="等线" Tag="DengXian,Segoe UI,sans-serif"/>
                        <ComboBoxItem Content="魏碑" Tag="STXinwei,FZWeiBei,KaiTi,serif"/>
                    </ComboBox>

                    <StackPanel Spacing="2">
                        <Grid>
                            <TextBlock Text="字号" FontSize="12" Foreground="{StaticResource MutedInkBrush}"/>
                            <TextBlock x:Name="SizeText" Text="26" HorizontalAlignment="Right"
                                       FontSize="12" Foreground="{StaticResource BookInkBrush}"/>
                        </Grid>
                        <Slider x:Name="SizeSlider" Minimum="14" Maximum="34" Value="26"
                                TickFrequency="1" ValueChanged="SizeSlider_ValueChanged"/>
                    </StackPanel>

                    <ComboBox x:Name="SettingsVoiceCombo" Header="朗读音色" HorizontalAlignment="Stretch"
                              SelectionChanged="SettingsVoiceCombo_SelectionChanged"/>

                    <StackPanel Spacing="2">
                        <Grid>
                            <TextBlock Text="朗读语速" FontSize="12" Foreground="{StaticResource MutedInkBrush}"/>
                            <TextBlock x:Name="SettingsRateText" Text="1.0x" HorizontalAlignment="Right"
                                       FontSize="12" Foreground="{StaticResource BookInkBrush}"/>
                        </Grid>
                        <Slider x:Name="SettingsRateSlider" Minimum="0.6" Maximum="2.0" Value="1.0"
                                TickFrequency="0.1" ValueChanged="SettingsRateSlider_ValueChanged"/>
                    </StackPanel>

                    <Button Click="NotesList_Click" Background="{StaticResource SelectedSageBrush}" BorderThickness="0"
                            Height="40" CornerRadius="12" Content="查看本书笔记"
                            Foreground="{StaticResource ForestGreenBrush}"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ===== 底部翻页条 ===== -->
        <Grid Grid.Row="2" Background="{StaticResource ChromeBgBrush}" Padding="20,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button x:Name="PrevChapterButton" Grid.Column="0" Click="PrevChapter_Click" Background="{StaticResource SidebarBgBrush}" BorderThickness="0"
                    CornerRadius="12" HorizontalAlignment="Left" VerticalAlignment="Center" Padding="14,8">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE76B;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{StaticResource BookInkBrush}"/>
                    <TextBlock Text="上一章" Foreground="{StaticResource BookInkBrush}" FontSize="13"/>
                </StackPanel>
            </Button>
            <Border Grid.Column="1" Background="{StaticResource SidebarBgBrush}" CornerRadius="14" Padding="5,3">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Button Click="Prev_Click" Background="Transparent" BorderThickness="0" CornerRadius="10" Width="32" Height="30" Padding="0">
                        <FontIcon Glyph="&#xE76B;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{StaticResource BookInkBrush}" />
                    </Button>
                    <TextBlock x:Name="PageIndicatorText" Text="- / -"
                               Foreground="{StaticResource MutedInkBrush}"
                               FontFamily="Microsoft YaHei UI" FontSize="12" VerticalAlignment="Center" />
                    <Button Click="Next_Click" Background="Transparent" BorderThickness="0" CornerRadius="10" Width="32" Height="30" Padding="0">
                        <FontIcon Glyph="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{StaticResource BookInkBrush}" />
                    </Button>
                </StackPanel>
            </Border>
            <Button x:Name="NextChapterButton" Grid.Column="2" Click="NextChapter_Click" Background="{StaticResource SidebarBgBrush}" BorderThickness="0"
                    CornerRadius="12" HorizontalAlignment="Right" VerticalAlignment="Center" Padding="14,8">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="下一章" Foreground="{StaticResource BookInkBrush}" FontSize="13"/>
                    <FontIcon Glyph="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{StaticResource BookInkBrush}"/>
                </StackPanel>
            </Button>
        </Grid>
    </Grid>
</Page>
