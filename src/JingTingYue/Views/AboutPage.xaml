<Page x:Class="JingTingYue.Views.AboutPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      FontFamily="Microsoft YaHei UI">
    <Grid Background="{StaticResource MainBgBrush}">
        <Grid.RowDefinitions><RowDefinition Height="76"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid Background="{StaticResource ChromeBgBrush}" Padding="28,0">
            <Button Click="Back_Click" HorizontalAlignment="Left" VerticalAlignment="Center"
                    Background="{StaticResource SidebarBgBrush}" BorderThickness="0" CornerRadius="12" Padding="14,9">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE76B;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{StaticResource BookInkBrush}"/>
                    <TextBlock Text="返回书架" FontSize="13" Foreground="{StaticResource BookInkBrush}"/>
                </StackPanel>
            </Button>
        </Grid>
        <ScrollViewer Grid.Row="1">
            <StackPanel MaxWidth="720" HorizontalAlignment="Center" Padding="30,64,30,80" Spacing="28">
                <Border Width="76" Height="76" CornerRadius="20" Background="{StaticResource ForestGreenBrush}" HorizontalAlignment="Left">
                    <TextBlock Text="静" FontFamily="KaiTi" FontSize="38" Foreground="{StaticResource OnAccentBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Spacing="8">
                    <TextBlock Text="ABOUT  /  关于" FontSize="11" CharacterSpacing="150" Foreground="{StaticResource ForestGreenBrush}"/>
                    <TextBlock Text="静听阅" FontSize="42" FontWeight="SemiBold" Foreground="{StaticResource BookInkBrush}"/>
                    <TextBlock Text="让阅读和聆听，都慢下来。" FontSize="17" Foreground="{StaticResource MutedInkBrush}"/>
                </StackPanel>
                <Border Height="1" Background="{StaticResource HairlineBrush}"/>
                <StackPanel Spacing="14">
                    <TextBlock Text="一处安静的阅读空间" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource BookInkBrush}"/>
                    <TextBlock Text="导入 EPUB，按喜欢的字体与主题阅读；留下摘录和笔记，也可以让书页为你朗读。"
                               FontSize="15" TextWrapping="Wrap" LineHeight="27" Foreground="{StaticResource BookInkBrush}"/>
                    <TextBlock Text="书籍、笔记和阅读进度保存在这台电脑上。朗读使用本机语音服务；启动朗读前，请确保语音服务正在运行。"
                               FontSize="14" TextWrapping="Wrap" LineHeight="25" Foreground="{StaticResource MutedInkBrush}"/>
                </StackPanel>
                <Border Background="{StaticResource NoteCardBrush}" CornerRadius="18" Padding="22,18">
                    <Grid>
                        <StackPanel Spacing="4">
                            <TextBlock Text="当前版本" FontSize="12" Foreground="{StaticResource MutedInkBrush}"/>
                            <TextBlock x:Name="VersionText" FontSize="16" Foreground="{StaticResource BookInkBrush}"/>
                        </StackPanel>
                        <TextBlock Text="静听阅 · 为好书留一盏灯" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                   FontSize="12" Foreground="{StaticResource ForestGreenBrush}"/>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
