<Page x:Class="JingTingYue.Views.BookshelfPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" FontFamily="Microsoft YaHei UI">
    <Grid Background="{StaticResource MainBgBrush}">
        <Grid.ColumnDefinitions><ColumnDefinition Width="244"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Grid Background="{StaticResource ChromeBgBrush}">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="12" Margin="28,34,18,0">
                <Border Width="38" Height="38" CornerRadius="11" Background="{StaticResource ForestGreenBrush}">
                    <FontIcon Glyph="&#xE82D;" FontFamily="Segoe MDL2 Assets" FontSize="17" Foreground="{StaticResource OnAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center" Spacing="1">
                    <TextBlock Text="静听阅" FontSize="19" FontWeight="SemiBold" Foreground="{StaticResource BookInkBrush}"/>
                    <TextBlock Text="YOUR READING SPACE" FontSize="9" CharacterSpacing="80" Foreground="{StaticResource MutedInkBrush}"/>
                </StackPanel>
            </StackPanel>
            <StackPanel Grid.Row="1" Margin="16,64,16,0" Spacing="12">
                <TextBlock Text="我的空间" FontSize="11" CharacterSpacing="120" FontWeight="SemiBold" Foreground="{StaticResource MutedInkBrush}" Margin="14,0,0,4"/>
                <StackPanel x:Name="NavPanel"/>
            </StackPanel>
            <StackPanel Grid.Row="2" Margin="28,0,24,34" Spacing="12">
                <Border Height="1" Background="{StaticResource HairlineBrush}" Margin="0,0,0,12"/>
                <TextBlock Text="阅读外观" FontSize="11" CharacterSpacing="100" Foreground="{StaticResource MutedInkBrush}"/>
                <StackPanel x:Name="ThemeButtons" Orientation="Horizontal" Spacing="6">
                    <Button Click="Theme_Click" Tag="paper" Content="纸白" Padding="9,6" FontSize="11" CornerRadius="9" Background="{StaticResource SidebarBgBrush}" Foreground="{StaticResource BookInkBrush}" BorderThickness="0"/>
                    <Button Click="Theme_Click" Tag="sepia" Content="暖棕" Padding="9,6" FontSize="11" CornerRadius="9" Background="{StaticResource SidebarBgBrush}" Foreground="{StaticResource BookInkBrush}" BorderThickness="0"/>
                    <Button Click="Theme_Click" Tag="night" Content="夜间" Padding="9,6" FontSize="11" CornerRadius="9" Background="{StaticResource SidebarBgBrush}" Foreground="{StaticResource BookInkBrush}" BorderThickness="0"/>
                </StackPanel>
            </StackPanel>
            <Border Grid.ColumnSpan="1" HorizontalAlignment="Right" Width="1" Background="{StaticResource HairlineBrush}"/>
        </Grid>
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Padding="64,52,64,72">
                <Grid Margin="0,0,0,48">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel Spacing="9">
                        <TextBlock Text="MY LIBRARY  /  私人书库" FontSize="11" CharacterSpacing="160" Foreground="{StaticResource ForestGreenBrush}" FontWeight="SemiBold"/>
                        <TextBlock Text="好书，值得慢慢读。" FontSize="42" FontWeight="SemiBold" Foreground="{StaticResource BookInkBrush}"/>
                        <TextBlock Text="在这里继续阅读，或为书架添一本新书。" FontSize="14" Foreground="{StaticResource MutedInkBrush}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="1" Click="ImportEpub_Click" Background="{StaticResource ForestGreenBrush}" Foreground="{StaticResource OnAccentBrush}" BorderThickness="0" CornerRadius="15" Height="44" Padding="20,0" VerticalAlignment="Bottom">
                        <Button.Resources>
                            <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="ForestGreenBrush"/>
                            <StaticResource x:Key="ButtonForegroundPointerOver" ResourceKey="OnAccentBrush"/>
                            <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="ForestGreenDeepBrush"/>
                            <StaticResource x:Key="ButtonForegroundPressed" ResourceKey="OnAccentBrush"/>
                        </Button.Resources>
                        <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="13"/><TextBlock Text="导入 EPUB" FontSize="13" FontWeight="SemiBold"/></StackPanel>
                    </Button>
                </Grid>
                <Border x:Name="ContinueCard" Background="{StaticResource SelectedSageBrush}" CornerRadius="20" Padding="28" Margin="0,0,0,52" Tapped="ContinueCard_Click">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Border x:Name="ContinueCover" Width="76" Height="102" CornerRadius="5,10,10,5" Background="{StaticResource ForestGreenBrush}"><FontIcon Glyph="&#xE82D;" FontFamily="Segoe MDL2 Assets" FontSize="27" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                        <StackPanel Grid.Column="1" Margin="26,0,20,0" VerticalAlignment="Center" Spacing="8">
                            <TextBlock Text="接着读" Foreground="{StaticResource ForestGreenBrush}" FontSize="11" CharacterSpacing="130" FontWeight="SemiBold"/>
                            <TextBlock x:Name="ContinueTitleText" Foreground="{StaticResource BookInkBrush}" FontSize="21" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="从上次停下的地方，继续这段阅读。" Foreground="{StaticResource MutedInkBrush}" FontSize="13"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center"><TextBlock x:Name="ContinueProgressText" Foreground="{StaticResource MutedInkBrush}" FontSize="14"/><FontIcon Glyph="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="{StaticResource ForestGreenBrush}"/></StackPanel>
                    </Grid>
                </Border>
                <Grid Margin="0,0,0,22">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="全部藏书" FontSize="25" FontWeight="SemiBold" Foreground="{StaticResource BookInkBrush}"/>
                    <TextBlock x:Name="BookCountText" Grid.Column="1" Foreground="{StaticResource MutedInkBrush}" FontSize="12" VerticalAlignment="Center"/>
                </Grid>
                <Border Height="1" Background="{StaticResource HairlineBrush}" Margin="0,0,0,22"/>
                <GridView x:Name="BookGrid" SelectionMode="None" IsItemClickEnabled="False" Background="Transparent" BorderThickness="0" Padding="0">
                    <GridView.Resources>
                        <SolidColorBrush x:Key="GridViewItemBackgroundPointerOver" Color="Transparent"/>
                        <SolidColorBrush x:Key="GridViewItemBackgroundPressed" Color="Transparent"/>
                    </GridView.Resources>
                    <GridView.ItemContainerStyle>
                        <Style TargetType="GridViewItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0,0,30,30"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                        </Style>
                    </GridView.ItemContainerStyle>
                </GridView>
                <Border x:Name="EmptyState" Background="{StaticResource ChromeBgBrush}" CornerRadius="18" Padding="40" Visibility="Collapsed">
                    <StackPanel HorizontalAlignment="Center" Spacing="10">
                        <FontIcon Glyph="&#xE82D;" FontFamily="Segoe MDL2 Assets" FontSize="32" Foreground="{StaticResource ForestGreenBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Text="从一本书开始" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource BookInkBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Text="导入 EPUB，把喜欢的文字留在自己的书架。" FontSize="13" Foreground="{StaticResource MutedInkBrush}" HorizontalAlignment="Center"/>
                        <Button Click="ImportEpub_Click" Content="导入一本书" Background="{StaticResource ForestGreenBrush}" Foreground="{StaticResource OnAccentBrush}" BorderThickness="0" CornerRadius="12" Padding="18,8" HorizontalAlignment="Center" Margin="0,8,0,0">
                            <Button.Resources>
                                <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="ForestGreenBrush"/>
                                <StaticResource x:Key="ButtonForegroundPointerOver" ResourceKey="OnAccentBrush"/>
                                <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="ForestGreenDeepBrush"/>
                                <StaticResource x:Key="ButtonForegroundPressed" ResourceKey="OnAccentBrush"/>
                            </Button.Resources>
                        </Button>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
