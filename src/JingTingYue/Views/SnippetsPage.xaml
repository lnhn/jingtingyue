<Page x:Class="JingTingYue.Views.SnippetsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      FontFamily="Microsoft YaHei UI">
    <Grid Background="{StaticResource MainBgBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 左栏：片段列表 -->
        <Grid Grid.Column="0" Background="{StaticResource ChromeBgBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 顶部品牌区 + 返回 -->
            <Grid Grid.Row="0" Margin="24,26,18,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12">
                    <Border Width="38" Height="38" CornerRadius="11" Background="{StaticResource ForestGreenBrush}">
                        <FontIcon Glyph="&#xE8D6;" FontFamily="Segoe MDL2 Assets" FontSize="17"
                                   Foreground="{StaticResource OnAccentBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center" Spacing="1">
                        <TextBlock Text="朗读片段" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource BookInkBrush}" />
                        <TextBlock Text="PASTE &amp; LISTEN" FontSize="9" CharacterSpacing="80" Foreground="{StaticResource MutedInkBrush}" />
                    </StackPanel>
                </StackPanel>
                <Button Grid.Column="2" Click="BackToShelf_Click"
                        Background="Transparent" Foreground="{StaticResource MutedInkBrush}"
                        BorderThickness="0" CornerRadius="8" Padding="8,6" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <FontIcon Glyph="&#xE72B;" FontFamily="Segoe MDL2 Assets" FontSize="12" />
                        <TextBlock Text="书库" FontSize="12" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- 新建按钮 -->
            <Button Grid.Row="1" Click="NewSnippet_Click" Margin="24,18,24,8"
                    Background="{StaticResource ForestGreenBrush}" Foreground="{StaticResource OnAccentBrush}"
                    BorderThickness="0" CornerRadius="12" Height="40" Padding="16,0"
                    HorizontalAlignment="Stretch">
                <Button.Resources>
                    <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="ForestGreenBrush" />
                    <StaticResource x:Key="ButtonForegroundPointerOver" ResourceKey="OnAccentBrush" />
                    <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="ForestGreenDeepBrush" />
                    <StaticResource x:Key="ButtonForegroundPressed" ResourceKey="OnAccentBrush" />
                </Button.Resources>
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                    <FontIcon Glyph="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="13" />
                    <TextBlock Text="新建片段" FontSize="13" FontWeight="SemiBold" />
                </StackPanel>
            </Button>

            <!-- 片段列表 -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="12,8,12,12">
                <StackPanel x:Name="SnippetList" Spacing="4" />
            </ScrollViewer>
        </Grid>

        <Border Grid.Column="0" Grid.RowSpan="3" HorizontalAlignment="Right" Width="1" Background="{StaticResource HairlineBrush}" />

        <!-- 右栏：编辑 + 朗读 -->
        <Grid Grid.Column="1" Margin="0,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 标题行 -->
            <Grid Grid.Row="0" Margin="40,28,40,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="TitleBox" PlaceholderText="给这段文字起个标题…"
                         FontSize="20" FontWeight="SemiBold"
                         Background="Transparent" BorderThickness="0"
                         Foreground="{StaticResource BookInkBrush}"
                         Padding="0,4" VerticalContentAlignment="Center" />
                <Button Grid.Column="1" Click="Save_Click" Margin="8,0,0,0"
                        Background="{StaticResource ForestGreenBrush}" Foreground="{StaticResource OnAccentBrush}"
                        BorderThickness="0" CornerRadius="12" Height="38" Padding="18,0" VerticalAlignment="Center">
                    <Button.Resources>
                        <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="ForestGreenBrush" />
                        <StaticResource x:Key="ButtonForegroundPointerOver" ResourceKey="OnAccentBrush" />
                        <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="ForestGreenDeepBrush" />
                        <StaticResource x:Key="ButtonForegroundPressed" ResourceKey="OnAccentBrush" />
                    </Button.Resources>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE74E;" FontFamily="Segoe MDL2 Assets" FontSize="12" />
                        <TextBlock Text="保存" FontSize="13" FontWeight="SemiBold" />
                    </StackPanel>
                </Button>
                <Button Grid.Column="2" Click="Delete_Click" Margin="8,0,0,0"
                        Background="Transparent" Foreground="{StaticResource DangerBrush}"
                        BorderThickness="0" CornerRadius="12" Height="38" Padding="14,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="12" />
                        <TextBlock Text="删除" FontSize="13" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- 文本编辑区 -->
            <Grid Grid.Row="1" Margin="40,0,40,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <!-- 编辑工具栏：字体、字号 -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10" Margin="0,0,0,10" VerticalAlignment="Center">
                    <ComboBox x:Name="FontCombo" Width="130" FontSize="13" SelectionChanged="FontCombo_SelectionChanged">
                        <ComboBoxItem Content="宋体" Tag="SimSun" IsSelected="True"/>
                        <ComboBoxItem Content="楷体" Tag="KaiTi"/>
                        <ComboBoxItem Content="仿宋" Tag="FangSong"/>
                        <ComboBoxItem Content="微软雅黑" Tag="Microsoft YaHei"/>
                        <ComboBoxItem Content="黑体" Tag="SimHei"/>
                        <ComboBoxItem Content="等线" Tag="DengXian"/>
                    </ComboBox>
                    <TextBlock Text="字号" FontSize="12" Foreground="{StaticResource MutedInkBrush}" VerticalAlignment="Center" Margin="8,0,0,0" />
                    <Button Click="FontSize_Dec" Background="{StaticResource SidebarBgBrush}" Foreground="{StaticResource BookInkBrush}"
                            BorderThickness="0" CornerRadius="8" Width="28" Height="28" Padding="0" FontSize="14" Content="A−" />
                    <TextBlock x:Name="FontSizeText" Text="20" FontSize="13" Foreground="{StaticResource BookInkBrush}"
                               Width="30" VerticalAlignment="Center" TextAlignment="Center" />
                    <Button Click="FontSize_Inc" Background="{StaticResource SidebarBgBrush}" Foreground="{StaticResource BookInkBrush}"
                            BorderThickness="0" CornerRadius="8" Width="28" Height="28" Padding="0" FontSize="14" Content="A+" />
                </StackPanel>
                <Border Grid.Row="1" CornerRadius="16"
                        Background="{StaticResource ChromeBgBrush}"
                        BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1">
                    <TextBox x:Name="TextEditor"
                             PlaceholderText="把你想读的文字粘贴到这里，然后点下方的朗读按钮。"
                             Background="Transparent" BorderThickness="0"
                             Foreground="{StaticResource BookInkBrush}"
                             Padding="28,28" FontSize="20" FontFamily="SimSun"
                             AcceptsReturn="True" TextWrapping="Wrap"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             TextChanged="TextEditor_TextChanged" />
                </Border>
            </Grid>

            <!-- 朗读控制栏 -->
            <Border Grid.Row="2" Margin="40,16,40,28" CornerRadius="16"
                    Background="{StaticResource ChromeBgBrush}"
                    BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1"
                    Padding="20,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- 播放/暂停 -->
                    <Button x:Name="PlayButton" Grid.Column="0" Click="Play_Click"
                            Width="52" Height="52" CornerRadius="26"
                            Background="{StaticResource ForestGreenBrush}" Foreground="{StaticResource OnAccentBrush}"
                            BorderThickness="0" Padding="0">
                        <Button.Resources>
                            <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="ForestGreenDeepBrush" />
                            <StaticResource x:Key="ButtonForegroundPointerOver" ResourceKey="OnAccentBrush" />
                            <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="ForestGreenDeepBrush" />
                            <StaticResource x:Key="ButtonForegroundPressed" ResourceKey="OnAccentBrush" />
                        </Button.Resources>
                        <FontIcon x:Name="PlayIcon" Glyph="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="20" />
                    </Button>

                    <!-- 停止 -->
                    <Button x:Name="StopButton" Grid.Column="1" Click="Stop_Click"
                            Width="44" Height="44" CornerRadius="22" Margin="12,0,0,0"
                            Background="{StaticResource SidebarBgBrush}" Foreground="{StaticResource BookInkBrush}"
                            BorderThickness="0" Padding="0" IsEnabled="False"
                            VerticalAlignment="Center">
                        <Button.Resources>
                            <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="#E7E3DE" />
                            <SolidColorBrush x:Key="ButtonForegroundDisabled" Color="#B5B3AE" />
                        </Button.Resources>
                        <FontIcon Glyph="&#xE71A;" FontFamily="Segoe MDL2 Assets" FontSize="15" />
                    </Button>

                    <!-- 状态文字 -->
                    <TextBlock x:Name="StatusText" Grid.Column="2" Text="● 准备就绪"
                               FontSize="13" Foreground="{StaticResource MutedInkBrush}"
                               VerticalAlignment="Center" Margin="16,0,0,0" />

                    <!-- 音色选择 -->
                    <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock Text="音色" FontSize="12" Foreground="{StaticResource MutedInkBrush}" VerticalAlignment="Center" />
                        <ComboBox x:Name="VoiceCombo" Width="150" FontSize="13"
                                  HorizontalAlignment="Center" SelectionChanged="VoiceCombo_SelectionChanged" />
                    </StackPanel>

                    <!-- 语速 -->
                    <StackPanel x:Name="RatePanel" Grid.Column="5" Orientation="Horizontal" Spacing="4" Margin="16,0,0,0" VerticalAlignment="Center" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
