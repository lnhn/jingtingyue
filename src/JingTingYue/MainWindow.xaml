<Window
    x:Class="JingTingYue.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="静听阅"
    Activated="Window_Activated">
    <Grid Background="{StaticResource MainBgBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 自定义标题栏 -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Background="{StaticResource ChromeBgBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="14,0,0,0">
                <Border Width="20" Height="20" CornerRadius="6" Background="{StaticResource ForestGreenBrush}">
                    <TextBlock Text="静" Foreground="{StaticResource OnAccentBrush}" FontFamily="KaiTi" FontSize="12"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="静听阅" FontFamily="KaiTi" FontSize="14" FontWeight="SemiBold"
                           Foreground="{StaticResource ForestGreenBrush}" VerticalAlignment="Center" />
            </StackPanel>
            <!-- 右侧系统按钮区（最小化/关闭由系统绘制，留出空间） -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="0" />
        </Grid>

        <Frame x:Name="RootFrame" Grid.Row="1" Background="{StaticResource MainBgBrush}" />
    </Grid>
</Window>
